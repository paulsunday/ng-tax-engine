# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/ng_tax_engine?schema=public"

# Required. Must be a long, random, secret value — the API refuses to boot without it
# (see src/api/auth/strategies/jwt.strategy.ts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Optional, defaults to "8h". Any value accepted by the `ms` package (e.g. "1h", "7d").
JWT_EXPIRES_IN="8h"

# Optional, defaults to 3000.
PORT=3000

# Optional, defaults to ./storage/documents. Local filesystem root for uploaded bank
# statements and documents (see src/documents/storage/LocalFileStorageAdapter.ts).
# Point this at a persistent volume in production; swap the adapter for S3/Blob storage
# before deploying multi-instance (local disk does not survive a redeploy or scale-out).
FILE_STORAGE_ROOT=""

# Comma-separated list of exact browser origins allowed to call this API via CORS
# (see src/api/main.ts). Empty/unset means NO browser origin is allowed — there is no
# permissive default. Example: "https://app.example.com,https://admin.example.com"
ALLOWED_ORIGINS=""
