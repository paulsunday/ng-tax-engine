# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/ng_tax_engine?schema=public"

# Required. Must be a long, random, secret value — the API refuses to boot without it
# (see src/api/auth/strategies/jwt.strategy.ts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Optional, defaults to "8h". Any value accepted by the `ms` package (e.g. "1h", "7d").
JWT_EXPIRES_IN="8h"

# Optional, defaults to 3000.
PORT=3000
