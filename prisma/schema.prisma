// Nigeria Tax Rules Engine — data model
// Design principles (see research/REGULATORY_RESEARCH_REPORT.md):
//  1. No statutory figure is a literal in code — every number lives in a TaxRule row with full source metadata.
//  2. Rules are effective-dated and versioned; a filed TaxReturn freezes the rule_version it used, so historical
//     returns are reproducible forever even after the rule changes (brief §25-26).
//  3. Rule edits never overwrite history — TaxRuleVersion rows are append-only; TaxRule points at the
//     "current" version but old versions remain queryable.
//  4. Capital allowance (tax) and depreciation (accounting) are modelled as separate tables on purpose (brief §14).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ───────────────────────────── Multi-tenancy, auth, RBAC, audit log (Phase 1) ─────────────────────────────
// Design: Organization is the tenant boundary. Every tenant-owned row (Company, and
// everything hanging off it) carries an organizationId, and every query in the API layer
// MUST filter by the caller's organizationId — see src/api/common/guards/tenant.guard.ts.
// There is deliberately no "global company list" endpoint for ordinary users.

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members   OrganizationUser[]
  companies Company[]
  auditLogs AuditLog[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  isPlatformAdmin Boolean  @default(false) // brief §5: Platform Administrator is cross-tenant, everyone else is tenant-scoped
  // Cross-tenant, same axis as isPlatformAdmin — NOT a per-organization Role. A statutory
  // tax rule serves every tenant's calculations at once, so "who may approve/activate one"
  // is a platform-level question, not a company-level job function (production-readiness
  // mandate §1: "Only authorised users with the appropriate tax administration role").
  isTaxRuleApprover Boolean @default(false)
  mfaEnabled      Boolean  @default(false)
  mfaSecret       String?  // TOTP secret, never returned by any API response
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  memberships     OrganizationUser[]
  auditLogs       AuditLog[]

  taxRuleReviews          TaxRuleReview[]
  taxRuleApprovals        TaxRuleApproval[]
  taxRuleChangeHistory    TaxRuleChangeHistory[]
  taxRuleActivationEvents TaxRuleActivationEvent[]
}

// A system-defined role per brief §5. Custom per-organization roles can be added later by
// giving Role an optional organizationId; left out of Phase 1 to keep RBAC auditable and
// simple while the rest of the app is still being built.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // "PLATFORM_ADMIN" | "COMPANY_OWNER" | "COMPANY_ADMIN" | "ACCOUNTANT" | "AUDITOR" | "TAX_OFFICER" | "FINANCE_MANAGER" | "MANAGEMENT_APPROVER" | "EMPLOYEE" | "READ_ONLY"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  memberships     OrganizationUser[]
}

// Permission keys per brief §5 (view/create/edit/delete/approve transactions, import bank
// statements, reconcile, run audit, create/approve adjustments, calculate taxes, prepare
// returns, approve/submit filing, view tax history, manage users/settings/tax config, view
// audit logs, export reports...). Stored as rows, not an enum, so new permissions can be
// added without a migration touching every role.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "transactions.create", "tax.filing.submit"
  description String

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

// The actual tenant-scoping join: who belongs to which organization, with what role.
model OrganizationUser {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  roleId         String
  role           Role             @relation(fields: [roleId], references: [id])
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())

  @@unique([organizationId, userId])
}

// Immutable (brief §29): no update/delete mutation is exposed for this model anywhere in
// the API layer — only AuditLogService.record() may insert. previousValue/newValue are
// free-form JSON snapshots so this one table can log any entity type in the system.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String   // e.g. "CREATE", "UPDATE", "DELETE", "APPROVE", "SUBMIT_FILING"
  objectType     String   // e.g. "Company", "TaxReturn", "CapitalAsset"
  objectId       String?
  previousValue  Json?
  newValue       Json?
  ipAddress      String?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([organizationId, objectType, objectId])
  @@index([userId])
}

// ───────────────────────────── Reference / lookup tables ─────────────────────────────

enum TaxType {
  CIT
  DEVELOPMENT_LEVY
  VAT
  WHT
  PAYE
  CAPITAL_ALLOWANCE
  TAX_LOSS
  CAPITAL_GAINS_TAX
  STAMP_DUTY
  STATE_LEVY
  GENERAL
}

enum Jurisdiction {
  NG_FEDERAL
  NG_STATE
  NG_LOCAL
  NG_FEDERAL_AND_STATE // rules whose basis applies regardless of which jurisdiction is asked (e.g. some WHT deadline rules)
}

// Full rule-governance lifecycle (production-readiness mandate §1). A rule is never ACTIVE
// merely because a field was edited by hand — see TaxRuleActivationEvent/TaxRuleApproval,
// which the governance API (src/api/tax-rule-governance) is the only writer of.
enum RuleStatus {
  DRAFT              // newly authored, no research attached yet
  RESEARCHED         // source attached but the figure itself is unconfirmed/ambiguous
  VERIFIED           // source-confirmed against the primary text
  PENDING_APPROVAL   // submitted for a qualified tax professional's decision
  APPROVED           // approved by a qualified tax professional, not yet activated
  ACTIVE             // live — usable for calculations within its effective window
  SUPERSEDED         // replaced by a newer rule_version; kept for historical reproducibility
  RETIRED            // administratively withdrawn
  REJECTED           // reviewed and rejected — never used
}

enum ConfidenceLevel {
  VERIFIED_RULE
  VERIFIED_CALCULATION
  REQUIRES_REVIEW
  MISSING_REGULATORY_INFORMATION
  POTENTIAL_REGULATORY_CHANGE
  UNSUPPORTED_SCENARIO
}

// Taxpayer/company classification axes (brief §8). Kept as rows, not enums, because new
// classifications (e.g. a new sector carve-out) must be addable without a code deploy.
model TaxpayerCategory {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "SMALL_COMPANY", "NON_RESIDENT_COMPANY", "PROFESSIONAL_SERVICES"
  label       String
  description String
  sourceRef   String?  // statutory basis for the category existing at all
  createdAt   DateTime @default(now())

  companyClassifications CompanyClassification[]
}

// ───────────────────────────── Rule engine core ─────────────────────────────

// One row per distinct rule concept (e.g. "cit_standard_rate"). Points at whichever
// TaxRuleVersion is currently ACTIVE; all versions remain in TaxRuleVersion for history.
model TaxRule {
  id            String       @id @default(cuid())
  ruleKey       String       // e.g. "cit_standard_rate", "vat_filing_deadline_rule"
  taxType       TaxType
  jurisdiction  Jurisdiction
  stateCode     String?      // populated when jurisdiction = NG_STATE
  description   String
  createdAt     DateTime     @default(now())

  versions      TaxRuleVersion[]

  @@unique([ruleKey, taxType, jurisdiction, stateCode])
  @@index([taxType, jurisdiction])
}

// Append-only. Never edit a row here after it has been referenced by a filed TaxReturn —
// instead create a new TaxRuleVersion with a later effective_from and mark the old one SUPERSEDED.
model TaxRuleVersion {
  id               String      @id @default(cuid())
  taxRuleId        String
  taxRule          TaxRule     @relation(fields: [taxRuleId], references: [id])
  ruleVersion      String      // semantic, e.g. "1.0", "1.1"
  taxYear          Int?        // the tax year this version is understood to apply to, where meaningful
  value            Json        // shape depends on rule: percentage, band table, deadline rule, object...
  // The four fields below are denormalized, display-friendly projections of `value` for
  // admin/review screens — populated during research/import, never the engine's source of
  // truth (the engine reads `value`, via RuleRecord, exactly as it always has). Deliberately
  // nullable and independently shaped per rule type, same philosophy as `value` itself: this
  // engine never forces one rigid structure onto every statutory figure (CIT rate vs a
  // capital-allowance band table vs a WHT schedule all need different shapes).
  rateValue        Decimal?    @db.Decimal(14, 6)
  thresholds       Json?
  allowances       Json?
  deductions       Json?
  calculationMethod String?    // human-readable description of how `value` is meant to be applied
  conditions       Json?       // eligibility conditions (company classification, recipient type, etc.)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  status           RuleStatus  @default(DRAFT)
  confidence       ConfidenceLevel @default(REQUIRES_REVIEW)

  sourceId         String
  source           TaxRuleSource @relation(fields: [sourceId], references: [id])
  sourceReference  String       // section/paragraph/schedule within the source document
  researchNotes    String?      // free-text: what was found, what's still ambiguous, why

  filingFrequency      String?        // e.g. "MONTHLY", "ANNUAL" — descriptive, the authoritative basis lives in TaxDeadlineRule
  filingDeadlineRuleId String?
  filingDeadlineRule   TaxDeadlineRule? @relation("FilingDeadlineRule", fields: [filingDeadlineRuleId], references: [id])
  paymentDeadlineRuleId String?
  paymentDeadlineRule   TaxDeadlineRule? @relation("PaymentDeadlineRule", fields: [paymentDeadlineRuleId], references: [id])

  verificationDate DateTime?
  verifiedBy       String?      // person or process that confirmed the figure against source text

  approvedBy       String?      // qualified tax professional — required before status can become ACTIVE
  approvedAt       DateTime?
  rejectedReason   String?

  supersedesId     String?      @unique
  supersedes       TaxRuleVersion? @relation("RuleSupersession", fields: [supersedesId], references: [id])
  supersededBy     TaxRuleVersion[] @relation("RuleSupersession")

  changeRecordId   String?
  changeRecord     RegulatoryChangeRecord? @relation(fields: [changeRecordId], references: [id])

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  taxReturnUsages  TaxReturnRuleUsage[]
  reviews          TaxRuleReview[]
  approvals        TaxRuleApproval[]
  changeHistory    TaxRuleChangeHistory[]
  activationEvents TaxRuleActivationEvent[]

  @@index([taxRuleId, effectiveFrom, effectiveTo])
  @@index([status])
}

// One row per "submit for approval" / "request revision" cycle. Distinct from
// TaxRuleApproval: a review is a recommendation from any authorised reviewer: an approval
// decision is specifically the qualified-tax-professional APPROVE/REJECT act.
model TaxRuleReview {
  id             String          @id @default(cuid())
  ruleVersionId  String
  ruleVersion    TaxRuleVersion  @relation(fields: [ruleVersionId], references: [id])
  reviewerId     String
  reviewer       User            @relation(fields: [reviewerId], references: [id])
  reviewType     String          // "SUBMISSION" | "REVISION_REQUEST"
  notes          String?
  createdAt      DateTime        @default(now())

  @@index([ruleVersionId])
}

// Append-only record of every APPROVE/REJECT decision. TaxRuleVersion.approvedBy/approvedAt
// mirror the latest decision for quick lookup; this table is the full history, including a
// prior REJECTED decision on a version that was later revised and approved.
model TaxRuleApproval {
  id             String          @id @default(cuid())
  ruleVersionId  String
  ruleVersion    TaxRuleVersion  @relation(fields: [ruleVersionId], references: [id])
  approverId     String
  approver       User            @relation(fields: [approverId], references: [id])
  decision       String          // "APPROVED" | "REJECTED"
  reason         String?
  createdAt      DateTime        @default(now())

  @@index([ruleVersionId])
}

// Generic append-only audit trail specific to rule-version mutations (narrower and more
// queryable than the general AuditLog table, for a dedicated "rule history" admin screen).
model TaxRuleChangeHistory {
  id             String          @id @default(cuid())
  ruleVersionId  String
  ruleVersion    TaxRuleVersion  @relation(fields: [ruleVersionId], references: [id])
  action         String          // "CREATED" | "RESEARCHED" | "VERIFIED" | "SUBMITTED" | "APPROVED" | "REJECTED" | "REVISION_REQUESTED" | "ACTIVATED" | "SUPERSEDED" | "RETIRED"
  performedById  String
  performedBy    User            @relation(fields: [performedById], references: [id])
  previousStatus RuleStatus?
  newStatus      RuleStatus?
  previousValue  Json?
  newValue       Json?
  reason         String?
  createdAt      DateTime        @default(now())

  @@index([ruleVersionId, createdAt])
}

// Focused timeline of ACTIVE transitions specifically — "when did this exact figure go
// live, and who flipped it" is its own compliance question, worth answering without
// filtering the generic change history.
model TaxRuleActivationEvent {
  id             String          @id @default(cuid())
  ruleVersionId  String
  ruleVersion    TaxRuleVersion  @relation(fields: [ruleVersionId], references: [id])
  activatedById  String
  activatedBy    User            @relation(fields: [activatedById], references: [id])
  activatedAt    DateTime        @default(now())
  deactivatedAt  DateTime?
  reason         String?

  @@index([ruleVersionId])
}

// Every rule must cite one of these. This is the "source hierarchy" object from the brief §2/§23.
model TaxRuleSource {
  id                String   @id @default(cuid())
  title             String   // e.g. "Nigeria Tax Act, 2025 (Act No. 7 of 2025)"
  issuingAuthority  String   // e.g. "National Assembly / Federal Government Printer"
  sourceTier        Int      // 1=legislation ... 8=public notice, per brief §2 hierarchy
  publicationDate   DateTime?
  effectiveDate     DateTime?
  url               String
  localArchivePath  String?  // path to the extracted/raw text snapshot kept under research/
  notes             String?
  createdAt         DateTime @default(now())

  ruleVersions      TaxRuleVersion[]
  deadlineRules     TaxDeadlineRule[]
  penaltyRules      TaxPenaltyRule[]
  interestRules     TaxInterestRule[]
  transitionRules   TaxTransitionRule[]
}

// Detect → Review → Validate → Approve → New version → Test → Deploy (brief §21/§39).
// A detected change NEVER mutates a TaxRuleVersion directly — it only ever proposes one.
model RegulatoryChangeRecord {
  id              String    @id @default(cuid())
  detectedAt      DateTime  @default(now())
  detectedBy      String    // e.g. "python-monitor:gazette-watcher"
  sourceUrl       String
  taxType         TaxType?
  summary         String
  proposedValue   Json?
  reviewStatus    String    @default("PENDING") // PENDING | IN_REVIEW | VALIDATED | REJECTED | ACTIVATED
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?

  resultingVersions TaxRuleVersion[]
}

// ───────────────────────────── Deadlines & penalties (distinct shape from TaxRule.value) ─────────────────────────────

enum DeadlineBasis {
  FIXED_DATE
  DAYS_AFTER_PERIOD_END
  DAYS_AFTER_EVENT
  FIXED_DAY_OF_FOLLOWING_MONTH
  ANNUAL
  QUARTERLY
  CUSTOM
}

model TaxDeadlineRule {
  id              String        @id @default(cuid())
  taxType         TaxType
  jurisdiction    Jurisdiction
  taxpayerCategoryCode String?  // null = applies to all categories
  obligationType  String        // "FILING" | "PAYMENT"
  basis           DeadlineBasis
  basisValue      Json          // e.g. { "dayOfMonth": 21 } or { "monthsAfterPeriodEnd": 6 }
  filingExtendsPayment Boolean  @default(false)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  sourceId        String
  source          TaxRuleSource @relation(fields: [sourceId], references: [id])
  sourceReference String
  status          RuleStatus    @default(DRAFT)
  createdAt       DateTime      @default(now())

  filingDeadlineForRuleVersions  TaxRuleVersion[] @relation("FilingDeadlineRule")
  paymentDeadlineForRuleVersions TaxRuleVersion[] @relation("PaymentDeadlineRule")
}

model TaxPenaltyRule {
  id              String        @id @default(cuid())
  taxType         TaxType
  violationType   String        // "LATE_FILING" | "LATE_PAYMENT" | "FAILURE_TO_DEDUCT" | "FAILURE_TO_REMIT" | ...
  formula         Json          // e.g. { "firstMonthNgn": 100000, "subsequentMonthNgn": 50000 }
  isEstimateOnly  Boolean       @default(true) // per brief §33 — never present as a final liability unless authority-confirmed
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  sourceId        String
  source          TaxRuleSource @relation(fields: [sourceId], references: [id])
  sourceReference String
  status          RuleStatus    @default(DRAFT)
  createdAt       DateTime      @default(now())
}

model TaxInterestRule {
  id              String        @id @default(cuid())
  taxType         TaxType
  referenceRate   String        // e.g. "CBN_MONETARY_POLICY_RATE" or a fixed "0.10"
  compounding     String?       // "ANNUAL" | "MONTHLY" | null if simple
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  sourceId        String
  source          TaxRuleSource @relation(fields: [sourceId], references: [id])
  sourceReference String
  status          RuleStatus    @default(DRAFT)
  createdAt       DateTime      @default(now())
}

model TaxTransitionRule {
  id              String   @id @default(cuid())
  description     String
  fromRegime      String   // e.g. "CITA_2004"
  toRegime        String   // e.g. "NTA_2025"
  taxType         TaxType
  mapping         Json     // how old-regime figures/positions map onto the new regime
  effectiveDate   DateTime
  sourceId        String
  source          TaxRuleSource @relation(fields: [sourceId], references: [id])
  sourceReference String
  createdAt       DateTime @default(now())
}

// ───────────────────────────── State revenue authority directory (brief §22, §32) ─────────────────────────────

enum AuthorityVerificationStatus {
  FULLY_RESEARCHED
  WEBSITE_CONFIRMED
  LOCATED_SECONDARY_SOURCE_UNVERIFIED
}

// Mirrors research/state_profiles.json. Deliberately NOT a source of tax rates — rates
// live in TaxRule (jurisdiction=NG_STATE, stateCode=this.stateCode). This table is purely
// "who administers tax here and how do I reach them", per the brief §22 directory requirement.
model StateRevenueAuthority {
  id                  String   @id @default(cuid())
  stateCode            String  @unique // ISO-ish 2-letter code used throughout, e.g. "EN", "LA", "FC"
  stateName             String
  authorityName         String
  officialWebsite       String?
  taxpayerPortalUrl     String?
  taxpayerIdScheme      String?
  apiAvailable          Boolean? // null = unknown/not yet researched
  apiDocumentationUrl   String?
  electronicReceipting  String?
  approvedPaymentGateways String[] @default([])
  applicableLaws        String[] @default([])
  verificationStatus    AuthorityVerificationStatus
  lastVerified           DateTime?
  verifiedBy             String?
  sourceUrls             String[] @default([])
  createdAt              DateTime @default(now())
}

// ───────────────────────────── Companies & classification ─────────────────────────────

model Company {
  id                String   @id @default(cuid())
  organizationId    String   // tenant boundary — every query for this model MUST filter by the caller's org (brief §4)
  organization      Organization @relation(fields: [organizationId], references: [id])
  name              String
  rcNumber          String?  @unique
  tin               String?  @unique
  incorporationDate DateTime
  accountingYearEnd String   // "MM-DD"
  isResident        Boolean  @default(true)
  sector            String?
  isProfessionalServices Boolean @default(false)
  vatRegistered     Boolean  @default(false)
  headOfficeStateCode String  // e.g. "EN" — drives the registered-office leg of the jurisdiction matrix, never the WHOLE matrix (brief §2)
  createdAt         DateTime @default(now())

  classifications   CompanyClassification[]
  employees         Employee[]
  branches          Branch[]
  capitalAssets     CapitalAsset[]
  taxLossEntries    TaxLossEntry[]
  taxReturns        TaxReturn[]
  transactions      BusinessTransaction[]
  complianceEntries ComplianceCalendarEntry[]

  // Phase 2 — accounting
  accounts          Account[]
  journalEntries    JournalEntry[]
  customers         Customer[]
  suppliers         Supplier[]
  invoices          Invoice[]
  expenses          Expense[]
  accountingPayments AccountingPayment[]
  assets            Asset[]

  // Phase 3 — bank import, reconciliation, documents
  bankAccounts      BankAccount[]
  bankStatementImports BankStatementImport[]
  bankTransactions  BankTransaction[]
  reconciliations   Reconciliation[]
  documents         Document[]

  // Phases 4-6 — audit engine, scenarios
  auditRuns         AuditRun[]
  scenarios         Scenario[]

  // Phases 7-10 — notifications
  notifications     Notification[]
}

// A company may have zero or many branches, each in its own state, each potentially
// carrying its own state-level obligations (brief §15, §17). Branch obligations are
// derived by the jurisdiction engine, never assumed equal to head-office obligations.
model Branch {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  label            String   // e.g. "Lagos Branch"
  stateCode        String
  lgaName          String?
  address          String?
  businessActivity String?
  hasBusinessPremises Boolean @default(true)
  registeredWithStateAuthority Boolean @default(false)
  stateTaxpayerId  String?  // e.g. an ESBN-equivalent issued by that state's IRS
  createdAt        DateTime @default(now())

  employees        Employee[]
}

// Classification is time-boxed because turnover/assets change year to year and must not
// be silently re-evaluated against today's numbers when reproducing a historical return.
model CompanyClassification {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  categoryId         String
  category           TaxpayerCategory @relation(fields: [categoryId], references: [id])
  periodStart        DateTime
  periodEnd          DateTime?
  turnoverNgn        Decimal? @db.Decimal(18, 2)
  fixedAssetsNgn     Decimal? @db.Decimal(18, 2)
  determinedAt       DateTime @default(now())
  determinationBasis String   // free text explanation, e.g. "turnover <= 50,000,000 and fixed assets <= 250,000,000 per NTA s.56"

  @@index([companyId, periodStart])
}

model Employee {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  branchId      String?  // which branch they are attached to, if any (null = head office)
  branch        Branch?  @relation(fields: [branchId], references: [id])
  fullName      String
  tin           String?
  stateOfResidenceCode String  // drives PAYE jurisdiction per NTAA — NOT assumed equal to company HQ state (brief §16)
  stateOfWorkCode      String  // where they actually work; tracked separately from residence
  isResident    Boolean  @default(true)
  createdAt     DateTime @default(now())

  payeCalculations PayeCalculation[]
}

model PayeCalculation {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id])
  periodMonth       Int
  periodYear        Int
  grossEmolumentNgn Decimal  @db.Decimal(18, 2)
  annualRentNgn     Decimal? @db.Decimal(18, 2)
  reliefAppliedNgn  Decimal  @db.Decimal(18, 2)
  taxableIncomeNgn  Decimal  @db.Decimal(18, 2)
  taxPayableNgn     Decimal  @db.Decimal(18, 2)
  ruleVersionId     String   // frozen reference to the PAYE band rule version used
  breakdown         Json     // transparent band-by-band breakdown, per brief §24
  confidence        ConfidenceLevel
  createdAt         DateTime @default(now())

  @@index([employeeId, periodYear, periodMonth])
}

// ───────────────────────────── Capital allowance register (separate from accounting depreciation) ─────────────────────────────

model CapitalAsset {
  id                     String   @id @default(cuid())
  companyId              String
  company                Company  @relation(fields: [companyId], references: [id])
  description            String
  assetClass             Int      // 1, 2 or 3 per NTA First Schedule Table I
  qualifyingExpenditureNgn Decimal @db.Decimal(18, 2)
  acquisitionDate        DateTime
  disposalDate           DateTime?
  disposalProceedsNgn    Decimal? @db.Decimal(18, 2)
  businessUsePercent      Decimal @default(100) @db.Decimal(5, 2)
  inUseAtPeriodEnd        Boolean @default(true)

  claims                 CapitalAllowanceClaim[]
}

model CapitalAllowanceClaim {
  id                String   @id @default(cuid())
  assetId           String
  asset             CapitalAsset @relation(fields: [assetId], references: [id])
  yearOfAssessment  Int
  openingResidueNgn Decimal  @db.Decimal(18, 2)
  allowanceClaimedNgn Decimal @db.Decimal(18, 2)
  notionalResidueNgn  Decimal @db.Decimal(18, 2) // the 1% statistical retention, never affects claimable amount
  closingResidueNgn Decimal  @db.Decimal(18, 2)
  ruleVersionId     String   // frozen reference to the capital allowance table version used
  createdAt         DateTime @default(now())

  @@unique([assetId, yearOfAssessment])
}

// ───────────────────────────── Tax loss schedule ─────────────────────────────

model TaxLossEntry {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  tradeOrBusiness  String   // ring-fencing key — a loss can only offset the trade that generated it
  yearIncurred     Int
  originalLossNgn  Decimal  @db.Decimal(18, 2)
  remainingLossNgn Decimal  @db.Decimal(18, 2)
  isDigitalAsset   Boolean  @default(false) // digital/virtual asset losses are ring-fenced separately per NTA s.27(6)
  createdAt        DateTime @default(now())

  utilisations     TaxLossUtilisation[]
}

model TaxLossUtilisation {
  id              String   @id @default(cuid())
  lossEntryId     String
  lossEntry       TaxLossEntry @relation(fields: [lossEntryId], references: [id])
  yearUtilised    Int
  amountUtilisedNgn Decimal @db.Decimal(18, 2)
  taxReturnId     String?
  createdAt       DateTime @default(now())
}

// ───────────────────────────── Transactions (drive WHT determination) ─────────────────────────────

model BusinessTransaction {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  counterpartyName  String
  counterpartyTin   String?
  counterpartyIsCorporate Boolean
  counterpartyIsResident  Boolean
  transactionCategory String  // maps to WHT rate table keys, e.g. "commission_consultancy_technical_management_professional_fees"
  grossAmountNgn    Decimal  @db.Decimal(18, 2)
  transactionDate   DateTime
  whtDetermination  WhtDetermination?
  createdAt         DateTime @default(now())
}

model WhtDetermination {
  id                String   @id @default(cuid())
  transactionId     String   @unique
  transaction       BusinessTransaction @relation(fields: [transactionId], references: [id])
  applicable        Boolean
  rateApplied       Decimal? @db.Decimal(6, 4)
  whtAmountNgn      Decimal? @db.Decimal(18, 2)
  netPaymentNgn     Decimal? @db.Decimal(18, 2)
  exemptionReason   String?
  ruleVersionId     String?
  explanation       String   // human-readable "why" per brief §11
  confidence        ConfidenceLevel
  createdAt         DateTime @default(now())
}

// ───────────────────────────── Returns, filings, payments ─────────────────────────────

// Distinguishes WHY a calculation attempt looks the way it does (production-readiness
// mandate §2) — orthogonal to both `status` (the approve/file workflow state) and
// `confidence` (the statutory confidence level of a completed calculation).
enum TaxReturnComplianceState {
  CALCULATED                    // a real number was produced — may legitimately be zero
  PENDING_RULE_APPROVAL         // a candidate rule exists but is not yet APPROVED/ACTIVE
  MISSING_REGULATORY_INFORMATION // no rule object exists at all for this period
  MISSING_TAXPAYER_INFORMATION  // the taxpayer's own required data (e.g. TIN) is absent
  CALCULATION_ERROR             // an unexpected failure during computation — never silently swallowed
}

model TaxReturn {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id])
  taxType              TaxType
  periodStart          DateTime
  periodEnd            DateTime
  taxpayerClassificationSnapshot Json // frozen copy of classification used, not a live FK re-evaluated later
  calculationVersion   String   // version of the *engine code* that produced this, independent of rule version
  calculationBreakdown Json     // full transparent calculation per brief §24
  // Null whenever complianceState is not CALCULATED — never a misleading literal 0 standing
  // in for "we don't actually know" (mandate §2: "Do not return zero liability as though
  // the taxpayer owes zero").
  taxLiabilityNgn      Decimal? @db.Decimal(18, 2)
  complianceState      TaxReturnComplianceState @default(CALCULATED)
  confidence           ConfidenceLevel

  preparedAt           DateTime?
  approvedAt           DateTime?
  approvedBy           String?
  submittedAt          DateTime?
  submissionReference  String?
  receiptReference     String?

  status               String   @default("DRAFT") // DRAFT | VALIDATED | APPROVED | FILED | REJECTED | SUPERSEDED
  rejectionReason      String?

  ruleUsages           TaxReturnRuleUsage[]
  filingAttempts       FilingAttempt[]
  payments             Payment[]
  complianceEntry      ComplianceCalendarEntry?

  createdAt            DateTime @default(now())

  @@index([companyId, taxType, periodStart])
}

// Join table recording exactly which rule versions were used to compute a return — this is
// what makes "recalculate with the old rule, not today's rule" possible (brief §25).
model TaxReturnRuleUsage {
  id             String   @id @default(cuid())
  taxReturnId    String
  taxReturn      TaxReturn @relation(fields: [taxReturnId], references: [id])
  ruleVersionId  String
  ruleVersion    TaxRuleVersion @relation(fields: [ruleVersionId], references: [id])

  @@unique([taxReturnId, ruleVersionId])
}

enum FilingErrorClass {
  TEMPORARY
  AUTHENTICATION
  VALIDATION
  AUTHORITY_REJECTION
  NETWORK
  DUPLICATE
  UNKNOWN
}

model FilingAttempt {
  id             String   @id @default(cuid())
  taxReturnId    String
  taxReturn      TaxReturn @relation(fields: [taxReturnId], references: [id])
  mode           String    // "MANUAL" | "APPROVAL_REQUIRED" | "AUTOMATIC"
  authorityAdapter String  // which TaxAuthorityAdapter implementation handled this
  attemptedAt    DateTime  @default(now())
  succeeded      Boolean
  errorClass     FilingErrorClass?
  rawResponse    Json?
  receiptReference String?
}

model Payment {
  id             String   @id @default(cuid())
  taxReturnId    String
  taxReturn      TaxReturn @relation(fields: [taxReturnId], references: [id])
  amountNgn      Decimal  @db.Decimal(18, 2)
  paidAt         DateTime?
  paymentReference String?
  status         String   @default("PENDING") // PENDING | CONFIRMED | FAILED
  createdAt      DateTime @default(now())
}

// ───────────────────────────── Compliance calendar ─────────────────────────────

model ComplianceCalendarEntry {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  taxReturnId         String?  @unique
  taxReturn           TaxReturn? @relation(fields: [taxReturnId], references: [id])
  taxType             TaxType
  periodLabel         String   // e.g. "September 2026"
  statutoryDeadline   DateTime
  internalDeadline    DateTime? // administrator safety margin, per brief §17
  recommendedFilingDate DateTime?
  amountNgn           Decimal? @db.Decimal(18, 2)
  responsiblePerson   String?
  approvalStatus      String   @default("AWAITING_APPROVAL")
  paymentStatus        String   @default("UNPAID")
  filingStatus         String   @default("NOT_FILED")
  isOverdue             Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([companyId, statutoryDeadline])
}

// ═════════════════════════════════════════════════════════════════════════
// PHASE 2 — Double-entry accounting engine (master-build-prompt §6, §31, §54)
// Design principles:
//  1. A JournalEntry, once POSTED, is never edited or deleted (brief §11 "never overwrite
//     source transactions"; §41 "no database reset"). Correcting a posted entry means
//     posting a new reversing entry (status VOID on the original, linked via reversalOfId).
//  2. Debits must equal credits on every JournalEntry — enforced in code
//     (src/accounting/doubleEntry.ts), not just trusted at the DB layer, because Prisma/SQL
//     cannot express "sum(debit) = sum(credit) across sibling rows" as a constraint.
//  3. Everything here is organizationId + companyId scoped — same tenant-isolation
//     discipline as Phase 1's Company/CompaniesService.
// ═════════════════════════════════════════════════════════════════════════

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// Chart of accounts. Hierarchical (parentAccountId) so e.g. "Current Assets" can group
// "Cash", "Accounts Receivable", "Inventory" underneath it for reporting roll-ups.
model Account {
  id             String      @id @default(cuid())
  organizationId String
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  code           String      // e.g. "1000", "4000" — user-facing account numbering
  name           String
  type           AccountType
  parentAccountId String?
  parentAccount   Account?   @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   Account[]  @relation("AccountHierarchy")
  isSystemAccount Boolean    @default(false) // true for default CoA accounts the UI shouldn't let a user delete
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())

  journalLines    JournalLine[]

  @@unique([companyId, code])
  @@index([organizationId, companyId])
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum JournalEntrySource {
  MANUAL
  INVOICE
  EXPENSE
  PAYMENT
  ASSET_ACQUISITION
  DEPRECIATION
  BANK_IMPORT
  ADJUSTMENT
  SYSTEM
}

model JournalEntry {
  id             String              @id @default(cuid())
  organizationId String
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  entryDate      DateTime
  description    String
  source         JournalEntrySource
  sourceId       String?             // id of the Invoice/Expense/Asset/etc. that generated this entry, if any
  documentReference String?
  status         JournalEntryStatus  @default(DRAFT)
  reversalOfId   String?             @unique
  reversalOf     JournalEntry?       @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry[]      @relation("JournalReversal")
  createdBy      String              // userId
  approvedBy     String?             // userId — set when a workflow requiring approval is used
  postedAt       DateTime?
  createdAt      DateTime            @default(now())

  lines          JournalLine[]

  @@index([organizationId, companyId, entryDate])
  @@index([source, sourceId])
}

// debitNgn/creditNgn are deliberately BOTH present (rather than one signed "amount" column)
// because that is how a ledger line is actually presented/audited — exactly one of the two
// must be > 0 and the other exactly 0, enforced in src/accounting/doubleEntry.ts.
model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debitNgn       Decimal      @default(0) @db.Decimal(18, 2)
  creditNgn      Decimal      @default(0) @db.Decimal(18, 2)
  description    String?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now())

  invoices       Invoice[]
  journalLines   JournalLine[]
  payments       AccountingPayment[]

  @@index([organizationId, companyId])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now())

  expenses       Expense[]
  journalLines   JournalLine[]
  payments       AccountingPayment[]

  @@index([organizationId, companyId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  invoiceNumber  String
  issueDate      DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotalNgn    Decimal       @db.Decimal(18, 2)
  vatAmountNgn   Decimal       @default(0) @db.Decimal(18, 2)
  totalNgn       Decimal       @db.Decimal(18, 2)
  amountPaidNgn  Decimal       @default(0) @db.Decimal(18, 2)
  notes          String?
  journalEntryId String?       @unique // set once posted to the GL
  createdAt      DateTime      @default(now())

  items          InvoiceItem[]
  payments       AccountingPayment[]

  @@unique([companyId, invoiceNumber])
  @@index([organizationId, companyId, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal @db.Decimal(14, 2)
  unitPriceNgn Decimal @db.Decimal(18, 2)
  vatRate     Decimal @default(0) @db.Decimal(6, 4) // e.g. 0.075 — a RATE, never hardcoded in logic; see note in InvoicesService
  lineTotalNgn Decimal @db.Decimal(18, 2)
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  expenseDate    DateTime
  description    String
  status         ExpenseStatus @default(DRAFT)
  subtotalNgn    Decimal       @db.Decimal(18, 2)
  vatAmountNgn   Decimal       @default(0) @db.Decimal(18, 2)
  totalNgn       Decimal       @db.Decimal(18, 2)
  amountPaidNgn  Decimal       @default(0) @db.Decimal(18, 2)
  journalEntryId String?       @unique
  createdAt      DateTime      @default(now())

  items          ExpenseItem[]
  payments       AccountingPayment[]

  @@index([organizationId, companyId, status])
}

model ExpenseItem {
  id          String  @id @default(cuid())
  expenseId   String
  expense     Expense @relation(fields: [expenseId], references: [id])
  accountId   String  // which expense account this line hits, e.g. "Rent", "Utilities"
  description String
  amountNgn   Decimal @db.Decimal(18, 2)
}

enum PaymentDirection {
  RECEIPT // money IN from a customer
  DISBURSEMENT // money OUT to a supplier
}

// Named AccountingPayment (not Payment) to avoid colliding with the Phase-1 tax-engine
// Payment model, which tracks tax liability settlement, not AR/AP cash application.
model AccountingPayment {
  id             String           @id @default(cuid())
  organizationId String
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  direction      PaymentDirection
  amountNgn      Decimal          @db.Decimal(18, 2)
  paymentDate    DateTime
  method         String?          // "BANK_TRANSFER" | "CASH" | "CARD" | "USSD" | ...
  reference      String?
  invoiceId      String?
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id])
  expenseId      String?
  expense        Expense?         @relation(fields: [expenseId], references: [id])
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  journalEntryId String?          @unique
  createdAt      DateTime         @default(now())

  @@index([organizationId, companyId])
}

enum DepreciationMethod {
  STRAIGHT_LINE
}

enum AssetStatus {
  ACTIVE
  DISPOSED
}

// ACCOUNTING asset register — distinct from the tax-engine's CapitalAsset/
// CapitalAllowanceClaim models (src/engine/capitalAllowance.ts). The two are never merged:
// accounting depreciation follows the company's own policy/useful-life estimate, while tax
// capital allowance follows NTA First Schedule Table I rates. See research report §2.6.
model Asset {
  id               String             @id @default(cuid())
  organizationId   String
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id])
  description      String
  category         String?
  acquisitionDate  DateTime
  costNgn          Decimal            @db.Decimal(18, 2)
  salvageValueNgn  Decimal            @default(0) @db.Decimal(18, 2)
  usefulLifeMonths Int
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  accumulatedDepreciationNgn Decimal   @default(0) @db.Decimal(18, 2)
  status           AssetStatus         @default(ACTIVE)
  disposalDate     DateTime?
  disposalProceedsNgn Decimal?         @db.Decimal(18, 2)
  journalEntryId   String?             @unique // acquisition posting
  createdAt        DateTime            @default(now())

  depreciationEntries AssetDepreciationEntry[]

  @@index([organizationId, companyId])
}

model AssetDepreciationEntry {
  id             String   @id @default(cuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id])
  periodYear     Int
  periodMonth    Int
  amountNgn      Decimal  @db.Decimal(18, 2)
  journalEntryId String?  @unique
  createdAt      DateTime @default(now())

  @@unique([assetId, periodYear, periodMonth])
}

// ═════════════════════════════════════════════════════════════════════════
// PHASE 3 — Bank import, reconciliation, document management + OCR
// (master-build-prompt §7-9, §54 Phase 3)
// ═════════════════════════════════════════════════════════════════════════

model BankAccount {
  id                String   @id @default(cuid())
  organizationId    String
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  accountName       String
  bankName          String
  accountNumber     String
  currency          String   @default("NGN")
  openingBalanceNgn Decimal  @default(0) @db.Decimal(18, 2)
  glAccountId       String?  // which Account (chart of accounts row) this bank account reconciles against — usually Cash/Bank
  createdAt         DateTime @default(now())

  statementImports  BankStatementImport[]
  transactions      BankTransaction[]
  reconciliations   Reconciliation[]

  @@index([organizationId, companyId])
}

enum StatementFileFormat {
  CSV
  XLSX
  PDF
}

enum StatementImportStatus {
  PENDING_MAPPING // auto-detection failed or was ambiguous — awaiting a manual column map
  PROCESSED
  FAILED
}

model BankStatementImport {
  id                String                 @id @default(cuid())
  organizationId    String
  companyId         String
  company           Company                @relation(fields: [companyId], references: [id])
  bankAccountId     String
  bankAccount       BankAccount            @relation(fields: [bankAccountId], references: [id])
  fileName          String
  fileFormat        StatementFileFormat
  storagePath       String
  columnMapping     Json?                  // resolved mapping used (or proposed, pending confirmation) — see src/bank-import/columnMapping.ts
  status            StatementImportStatus  @default(PENDING_MAPPING)
  importedRowCount  Int                    @default(0)
  skippedRowCount   Int                    @default(0)
  errorMessage      String?
  uploadedBy        String
  createdAt         DateTime               @default(now())

  transactions      BankTransaction[]

  @@index([organizationId, companyId])
}

enum BankTransactionMatchStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

model BankTransaction {
  id                String                     @id @default(cuid())
  organizationId    String
  companyId         String
  company           Company                    @relation(fields: [companyId], references: [id])
  bankAccountId     String
  bankAccount       BankAccount                @relation(fields: [bankAccountId], references: [id])
  importId          String?
  import            BankStatementImport?       @relation(fields: [importId], references: [id])
  transactionDate    DateTime
  narration          String
  reference          String?
  debitNgn            Decimal                   @default(0) @db.Decimal(18, 2)
  creditNgn           Decimal                   @default(0) @db.Decimal(18, 2)
  balanceAfterNgn      Decimal?                  @db.Decimal(18, 2)
  dedupeHash           String                    // sha256(bankAccountId + date + debit + credit + narration) — see bank-import module
  matchStatus          BankTransactionMatchStatus @default(UNMATCHED)
  matchedEntityType     String?                   // "AccountingPayment" | "JournalEntry" | ...
  matchedEntityId       String?
  matchConfidence        String?                  // "EXACT" | "LIKELY" | "MANUAL"
  reconciliationId        String?
  reconciliation           Reconciliation?          @relation(fields: [reconciliationId], references: [id])
  createdAt                DateTime                 @default(now())

  @@index([organizationId, companyId, bankAccountId])
  @@index([dedupeHash])
  @@index([matchStatus])
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
}

model Reconciliation {
  id                 String                @id @default(cuid())
  organizationId      String
  companyId            String
  company               Company              @relation(fields: [companyId], references: [id])
  bankAccountId          String
  bankAccount            BankAccount          @relation(fields: [bankAccountId], references: [id])
  periodLabel             String
  statementEndDate         DateTime
  statementBalanceNgn       Decimal             @db.Decimal(18, 2)
  ledgerBalanceNgn           Decimal             @db.Decimal(18, 2) // snapshot at completion/creation time
  status                     ReconciliationStatus @default(IN_PROGRESS)
  completedBy                 String?
  completedAt                  DateTime?
  createdAt                    DateTime            @default(now())

  transactions                 BankTransaction[]

  @@index([organizationId, companyId, bankAccountId])
}

enum DocumentCategory {
  INVOICE
  RECEIPT
  CONTRACT
  BANK_STATEMENT
  PAYROLL
  ASSET_PURCHASE
  TAX
  PAYMENT_EVIDENCE
  SUPPLIER
  CUSTOMER
  OTHER
}

enum OcrStatus {
  NOT_APPLICABLE
  PENDING
  COMPLETED
  FAILED
}

model Document {
  id                String           @id @default(cuid())
  organizationId    String
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  category          DocumentCategory
  fileName          String
  mimeType          String
  sizeBytes         Int
  storagePath       String
  checksumSha256    String
  linkedEntityType  String?          // e.g. "Invoice", "Expense", "BankTransaction", "Asset"
  linkedEntityId    String?
  ocrStatus         OcrStatus        @default(NOT_APPLICABLE)
  ocrExtractedData  Json?            // structured fields extracted — see src/documents/ocr/
  ocrConfidence     Json?            // per-field confidence, never a single opaque "99% accurate" claim
  inconsistencyFlags Json?           // e.g. ["AMOUNT_MISMATCH_WITH_LINKED_TRANSACTION"]
  uploadedBy        String
  createdAt         DateTime         @default(now())

  @@index([organizationId, companyId, category])
  @@index([linkedEntityType, linkedEntityId])
}

// ═════════════════════════════════════════════════════════════════════════
// PHASES 4-6 — Financial statements (derived on demand, not snapshotted —
// immutable POSTED entries, Phase 2, mean they're always reproducible),
// audit engine, and profit/loss scenarios (master-build-prompt §10-14, §24-25)
// ═════════════════════════════════════════════════════════════════════════

enum AuditRunType {
  NORMAL_AUDIT
}

enum AuditRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model AuditRun {
  id             String         @id @default(cuid())
  organizationId String
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  runType        AuditRunType   @default(NORMAL_AUDIT)
  periodStart    DateTime
  periodEnd      DateTime
  status         AuditRunStatus @default(RUNNING)
  runBy          String
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  findings       AuditFinding[]

  @@index([organizationId, companyId, periodStart])
}

enum FindingCategory {
  DUPLICATE_TRANSACTION
  MISSING_DOCUMENTATION
  UNUSUAL_TRANSACTION
  LARGE_TRANSACTION
  ROUND_NUMBER_ANOMALY
  UNRECONCILED_BANK_TRANSACTION
  TAX_CONSISTENCY
  PERIOD_CUTOFF
  REPEATED_VENDOR_OR_CUSTOMER
  UNBALANCED_LEDGER
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FindingStatus {
  OPEN
  REQUIRES_REVIEW
  RESOLVED
  DISMISSED
}

// Terminology is deliberately neutral (brief §10: "Potential anomaly", "Requires review",
// never an accusation of fraud) — see the description text generated in audit.service.ts.
model AuditFinding {
  id               String           @id @default(cuid())
  auditRunId       String
  auditRun         AuditRun         @relation(fields: [auditRunId], references: [id])
  category         FindingCategory
  severity         FindingSeverity
  description      String
  relatedEntityType String?
  relatedEntityId   String?
  status            FindingStatus   @default(OPEN)
  resolutionNotes   String?
  createdAt         DateTime        @default(now())

  @@index([auditRunId, category])
}

enum ScenarioType {
  NORMAL
  PROFIT_SCENARIO
  LOSS_SCENARIO
}

// A Scenario is a VERSIONED, REPRODUCIBLE snapshot (brief §47-48): it freezes exactly
// which unposted records were treated as hypothetically-included and the calculationVersion
// of the code that computed it, so re-rendering the same scenario later never silently
// drifts even if the underlying DRAFT invoices/expenses are edited afterward.
model Scenario {
  id                   String       @id @default(cuid())
  organizationId       String
  companyId            String
  company              Company      @relation(fields: [companyId], references: [id])
  scenarioType         ScenarioType
  periodStart          DateTime
  periodEnd            DateTime
  calculationVersion   String
  accountingProfitNgn  Decimal      @db.Decimal(18, 2)
  taxableProfitNgn     Decimal      @db.Decimal(18, 2)
  taxLiabilityNgn      Decimal      @db.Decimal(18, 2)
  breakdown            Json         // full transparent calculation, brief §24 style
  generatedBy          String
  createdAt            DateTime     @default(now())

  adjustments          ScenarioAdjustment[]

  @@index([organizationId, companyId, scenarioType, periodStart])
}

enum ScenarioAdjustmentApproval {
  PENDING
  APPROVED
  REJECTED
}

// Every adjustment traces to a REAL existing record (a DRAFT Invoice/Expense, or an
// Asset's own depreciation formula) — sourceId always resolves to that record. Nothing
// here is ever a fabricated figure (brief §12: "Do not invent transactions... Do not
// manipulate figures simply to achieve a target profit").
model ScenarioAdjustment {
  id                 String                     @id @default(cuid())
  scenarioId         String
  scenario           Scenario                   @relation(fields: [scenarioId], references: [id])
  sourceType         String                     // "Invoice" | "Expense" | "AssetDepreciation"
  sourceId           String
  description        String
  originalValueNgn   Decimal                    @db.Decimal(18, 2) // always 0 — not yet in the ledger
  adjustedValueNgn   Decimal                    @db.Decimal(18, 2)
  accountingTreatment String
  taxTreatment        String?
  confidence           String                    // ConfidenceLevel from the tax engine's shared vocabulary
  approvalStatus        ScenarioAdjustmentApproval @default(PENDING)
  createdAt              DateTime                  @default(now())

  @@index([scenarioId])
}

// ═════════════════════════════════════════════════════════════════════════
// PHASES 7-10 — Compliance notifications (master-build-prompt §26-27)
// In-app only: no email/SMS/WhatsApp provider is wired up (no credentials exist
// in this environment) — channel is recorded so a real provider can be plugged
// in later without changing anything that generates the notification content.
// ═════════════════════════════════════════════════════════════════════════

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  companyId      String?
  company        Company?            @relation(fields: [companyId], references: [id])
  userId         String?             // null = broadcast to everyone with access to the company
  category       String              // "UPCOMING_FILING" | "OVERDUE_FILING" | "MISSING_DOCUMENTS" | ...
  title          String
  body           String
  channel        NotificationChannel @default(IN_APP)
  status         NotificationStatus  @default(PENDING)
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime          @default(now())

  @@index([organizationId, userId, readAt])
  @@index([companyId, category])
}
